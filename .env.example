# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="https://your-app.vercel.app"

# Google OAuth (optional - get from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@votre-centre.com"

# SMTP (optional - for email verification & password reset)
# Works without config: logs emails to console in development
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Backup system (Super Admin)
# Secret used to protect the automatic backup cron endpoint (/api/cron/backup)
CRON_SECRET="generate-a-random-secret-here"
# Number of database snapshots to keep (older ones are pruned automatically)
BACKUP_RETENTION="14"

# Database maintenance / archiving (Super Admin)
# Runs daily via /api/cron/archive. Logs and read notifications are always
# archived/retained based on the settings below.
# Days to keep audit logs before moving them to archive_system_logs
LOG_RETENTION_DAYS="90"
# Days to keep read notifications before moving them to archive_notifications
NOTIFICATION_RETENTION_DAYS="180"
# Months of "seances / presences / paiements" history to keep in the live tables.
# Set to 0 (default) to disable archiving of business data entirely.
# Example: "12" keeps 12 months of history and archives everything older.
DATA_RETENTION_MONTHS="0"
