generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  super_admin
  admin
  prof
  eleve
}

enum PresenceStatut {
  present
  absent
}

enum SeanceStatut {
  planifiee
  en_cours
  terminee
  annulee
}

enum InscriptionStatut {
  actif
  inactif
}

enum MethodePaiement {
  especes
  virement
  cheque
  autre
}

enum TeacherTransactionType {
  EARNING
  PAYMENT
  ADJUSTMENT
  REVERSAL
}

enum TeacherTransactionStatus {
  active
  reversed
}

enum StudentTransactionType {
  PREPAYMENT
  COURSE_CONSUMPTION
  ADJUSTMENT
  REVERSAL
}

enum StudentTransactionStatus {
  active
  reversed
}

enum NiveauScolaire {
  primaire
  college
  lycee
}

enum Filiere {
  lettres
  economique
  informatique
  technique
  sciences
  math
}

// ─── Center (Tenant) ─────────────────────────────────────────────────────────

model Center {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(20)
  logo      String?  @db.Text
  phone     String?  @db.VarChar(20)
  address   String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  utilisateurs        Utilisateur[]
  groupes             Groupe[]
  matieres            Matiere[]
  notifications       Notification[]
  subscriptions       CenterSubscription[]
  teacherTransactions TeacherTransaction[]
  studentTransactions StudentTransaction[]
  pushSubscriptions   PushSubscription[]
  @@map("centers")
}

// ─── Utilisateur ─────────────────────────────────────────────────────────────

model Utilisateur {
  id             String    @id @default(uuid()) @db.Uuid
  centerId       String    @map("center_id") @db.Uuid
  nom            String    @db.VarChar(255)
  prenom         String    @db.VarChar(255)
  email          String    @unique @db.VarChar(255)
  motDePasse     String?   @map("mot_de_passe") @db.VarChar(255)
  telephone      String?   @db.VarChar(20)
  telephone2     String?   @db.VarChar(20)
  role           Role
  image          String?   @db.VarChar(500)
  dateNaissance  DateTime? @map("date_naissance") @db.Date
  actif          Boolean   @default(false)
  codeEleve      String?   @map("code_eleve") @db.VarChar(4)
  codeProf       String?   @map("code_prof") @db.VarChar(5)
  niveau         NiveauScolaire?
  classe         String?   @db.VarChar(50)
  filiere        Filiere?
  deletedAt      DateTime? @map("deleted_at")

  provider              String?   @default("credentials") @db.VarChar(50)
  providerId            String?   @map("provider_id") @db.VarChar(255)
  emailVerified         DateTime? @map("email_verified")
  emailVerificationToken String?  @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpiry DateTime? @map("email_verification_expiry")
  passwordResetToken    String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpiry   DateTime? @map("password_reset_expiry")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  center           Center          @relation(fields: [centerId], references: [id], onDelete: Cascade)
  groupesEnseigne  Groupe[]        @relation("ProfGroupes")
  inscriptions     Inscription[]
  presencesAsEleve Presence[]      @relation("PresenceEleve")
  presencesByAdmin Presence[]      @relation("PresenceEnregistrePar")
  paiements        Paiement[]
  tauxBenefice     TauxBenefice?
  notifications    Notification[]
  teacherTransactions TeacherTransaction[] @relation("TeacherTransactions")
  studentTransactions StudentTransaction[] @relation("StudentTransactions")
  pushSubscriptions   PushSubscription[]

  @@index([centerId, role])
  @@index([centerId, email])
  @@index([centerId, role, createdAt])
  @@index([role])
  @@index([codeEleve])
  @@index([codeProf])
  @@unique([centerId, codeEleve])
  @@unique([centerId, codeProf])
  @@map("utilisateurs")
}

// ─── Matiere ─────────────────────────────────────────────────────────────────

model Matiere {
  id          String   @id @default(uuid()) @db.Uuid
  centerId    String   @map("center_id") @db.Uuid
  nom         String   @db.VarChar(255)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  center  Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  groupes Groupe[]

  @@index([centerId])
  @@unique([centerId, nom])
  @@map("matieres")
}

// ─── Groupe ──────────────────────────────────────────────────────────────────

model Groupe {
  id             String   @id @default(uuid()) @db.Uuid
  centerId       String   @map("center_id") @db.Uuid
  nom            String   @db.VarChar(255)
  description    String?
  profId        String?  @map("prof_id") @db.Uuid
  matiereId      String?  @map("matiere_id") @db.Uuid
  prixParSeance  Decimal  @map("prix_par_seance") @db.Decimal(10, 2)
  forfaitMontant Decimal? @map("forfait_montant") @db.Decimal(10, 2)
  forfaitSeances Int?     @map("forfait_seances")
  capaciteMax    Int?     @map("capacite_max")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  center       Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  prof         Utilisateur? @relation("ProfGroupes", fields: [profId], references: [id], onDelete: SetNull)
  matiere      Matiere?     @relation(fields: [matiereId], references: [id], onDelete: SetNull)
  inscriptions Inscription[]
  seances      Seance[]
  paiements    Paiement[]

  @@index([centerId, profId])
  @@index([centerId])
  @@index([matiereId])
  @@map("groupes")
}

// ─── Inscription ─────────────────────────────────────────────────────────────

model Inscription {
  id              String            @id @default(uuid()) @db.Uuid
  eleveId         String            @map("eleve_id") @db.Uuid
  groupeId        String            @map("groupe_id") @db.Uuid
  dateInscription DateTime          @default(now()) @map("date_inscription")
  statut          InscriptionStatut @default(actif)

  eleve  Utilisateur @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  groupe Groupe      @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@unique([eleveId, groupeId])
  @@index([groupeId])
  @@index([groupeId, statut])
  @@index([eleveId, statut])
  @@map("inscriptions")
}

// ─── Seance ──────────────────────────────────────────────────────────────────

model Seance {
  id            String        @id @default(uuid()) @db.Uuid
  groupeId      String        @map("groupe_id") @db.Uuid
  date          DateTime      @db.Date
  heureDebut    DateTime?     @map("heure_debut") @db.Time
  heureFin      DateTime?     @map("heure_fin") @db.Time
  statut        SeanceStatut  @default(planifiee)
  notes         String?
  prixParSeance Decimal?      @map("prix_par_seance") @db.Decimal(10, 2)
  createdAt     DateTime      @default(now()) @map("created_at")

  groupe    Groupe       @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  presences Presence[]

  @@index([groupeId, date])
  @@index([date])
  @@map("seances")
}

// ─── Presence ────────────────────────────────────────────────────────────────

model Presence {
  id               String         @id @default(uuid()) @db.Uuid
  seanceId         String         @map("seance_id") @db.Uuid
  eleveId          String         @map("eleve_id") @db.Uuid
  statut           PresenceStatut
  enregistrePar    String?        @map("enregistre_par") @db.Uuid
  dateCreation     DateTime       @default(now()) @map("date_creation")
  dateModification DateTime       @default(now()) @map("date_modification")

  seance       Seance       @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  eleve        Utilisateur  @relation("PresenceEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  enregistreur Utilisateur? @relation("PresenceEnregistrePar", fields: [enregistrePar], references: [id], onDelete: SetNull)
  studentTransactions StudentTransaction[] @relation("StudentTransactionAttendance")

  @@unique([seanceId, eleveId])
  @@index([eleveId])
  @@index([eleveId, statut])
  @@map("presences")
}

// ─── Paiement ────────────────────────────────────────────────────────────────

model Paiement {
  id              String          @id @default(uuid()) @db.Uuid
  eleveId         String          @map("eleve_id") @db.Uuid
  groupeId        String          @map("groupe_id") @db.Uuid
  montant         Decimal         @db.Decimal(10, 2)
  datePaiement    DateTime        @default(now()) @map("date_paiement")
  methodePaiement MethodePaiement @map("methode_paiement")
  reference       String?
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")

  eleve  Utilisateur @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  groupe Groupe      @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@index([eleveId, groupeId])
  @@index([eleveId])
  @@index([groupeId, datePaiement])
  @@index([datePaiement])
  @@map("paiements")
}

// ─── TauxBenefice ────────────────────────────────────────────────────────────

model TauxBenefice {
  id              String   @id @default(uuid()) @db.Uuid
  profId          String   @unique @map("prof_id") @db.Uuid
  tauxPourcentage Decimal  @map("taux_pourcentage") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  prof Utilisateur @relation(fields: [profId], references: [id], onDelete: Cascade)

  @@map("taux_benefices")
}

// ─── TeacherTransaction (Comptabilité des professeurs) ──────────────────────

model TeacherTransaction {
  id            String                   @id @default(uuid()) @db.Uuid
  centerId      String                   @map("center_id") @db.Uuid
  teacherId     String                   @map("teacher_id") @db.Uuid
  type          TeacherTransactionType
  status        TeacherTransactionStatus @default(active)
  amount        Decimal                  @db.Decimal(10, 2)
  signedAmount  Decimal                  @map("signed_amount") @db.Decimal(10, 2)
  description   String                   @db.Text
  paymentMethod MethodePaiement?         @map("payment_method")
  date          DateTime                 @db.Date
  time          DateTime?                @db.Time
  receiptNumber String?                  @map("receipt_number") @db.VarChar(50)
  reference     String?                  @db.VarChar(100)
  notes         String?                  @db.Text
  createdBy     String?                  @map("created_by") @db.Uuid
  reversalOfId  String?                  @map("reversal_of_id") @db.Uuid
  reversedById  String?                  @map("reversed_by_id") @db.Uuid
  reversedAt    DateTime?                @map("reversed_at")
  createdAt     DateTime                 @default(now()) @map("created_at")

  center     Center                 @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacher    Utilisateur            @relation("TeacherTransactions", fields: [teacherId], references: [id], onDelete: Cascade)
  reversalOf TeacherTransaction?    @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals  TeacherTransaction[]   @relation("TransactionReversal")

  @@index([centerId, teacherId, date])
  @@index([teacherId, date])
  @@index([type, status])
  @@index([centerId, type])
  @@map("teacher_transactions")
}

// ─── StudentTransaction (Crédit / Solde prépayé des élèves) ──────────────────

model StudentTransaction {
  id            String                  @id @default(uuid()) @db.Uuid
  centerId      String                  @map("center_id") @db.Uuid
  eleveId       String                  @map("eleve_id") @db.Uuid
  type          StudentTransactionType
  status        StudentTransactionStatus @default(active)
  amount        Decimal                 @db.Decimal(10, 2)
  signedAmount  Decimal                 @map("signed_amount") @db.Decimal(10, 2)
  description   String                  @db.Text
  paymentMethod MethodePaiement?        @map("payment_method")
  date          DateTime                @db.Date
  time          DateTime?               @db.Time
  receiptNumber String?                 @map("receipt_number") @db.VarChar(50)
  reference     String?                 @db.VarChar(100)
  attendanceId  String?                 @map("attendance_id") @db.Uuid
  idempotencyKey String?                @map("idempotency_key") @db.VarChar(64)
  notes         String?                 @db.Text
  createdBy     String?                 @map("created_by") @db.Uuid
  reversalOfId  String?                 @map("reversal_of_id") @db.Uuid
  reversedById  String?                 @map("reversed_by_id") @db.Uuid
  reversedAt    DateTime?               @map("reversed_at")
  createdAt     DateTime                @default(now()) @map("created_at")

  center     Center              @relation(fields: [centerId], references: [id], onDelete: Cascade)
  eleve      Utilisateur         @relation("StudentTransactions", fields: [eleveId], references: [id], onDelete: Cascade)
  attendance Presence?           @relation("StudentTransactionAttendance", fields: [attendanceId], references: [id], onDelete: SetNull)
  reversalOf StudentTransaction? @relation("StudentTransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals  StudentTransaction[] @relation("StudentTransactionReversal")

  @@unique([eleveId, attendanceId])
  @@unique([idempotencyKey])
  @@unique([reversalOfId])
  @@index([centerId, eleveId, date])
  @@index([eleveId, date])
  @@index([type, status])
  @@index([centerId, type])
  @@map("student_transactions")
}

// ─── Notification ────────────────────────────────────────────────────────────

model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  centerId        String    @map("center_id") @db.Uuid
  destinataireId  String    @map("destinataire_id") @db.Uuid
  titre           String    @db.VarChar(255)
  message         String    @db.Text
  type            String    @db.VarChar(50)
  lu              Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at")

  center        Center      @relation(fields: [centerId], references: [id], onDelete: Cascade)
  destinataire  Utilisateur @relation(fields: [destinataireId], references: [id], onDelete: Cascade)

  @@index([centerId, destinataireId])
  @@index([destinataireId, lu])
  @@map("notifications")
}

// ─── PushSubscription (Web Push) ────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  centerId  String   @map("center_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @db.Text
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  center Center      @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user   Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

// ─── SystemLog (Audit) ────────────────────────────────────────────────────

model SystemLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String   @db.VarChar(100)
  entity    String?  @db.VarChar(50)
  entityId  String?  @map("entity_id") @db.Uuid
  details   Json?
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@index([createdAt])
  @@index([userId])
  @@map("system_logs")
}

// ─── SystemBackup (Base de données) ──────────────────────────────────────────

enum BackupStatus {
  en_cours
  ok
  echec
  restaure
}

enum BackupType {
  automatique
  manuel
}

model SystemBackup {
  id          String       @id @default(uuid()) @db.Uuid
  version     Int
  type        BackupType   @default(manuel)
  status      BackupStatus @default(en_cours)
  checksum    String?      @db.VarChar(64)
  sizeBytes   Int?
  rowCounts   Json?
  data        String?      @db.Text
  error       String?      @db.Text
  createdBy   String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?    @map("completed_at")
  restoredAt  DateTime?    @map("restored_at")

  @@index([createdAt])
  @@index([status])
  @@map("system_backups")
}

// ─── CenterSubscription ──────────────────────────────────────────────────────

enum SubscriptionStatus {
  active
  expired
  cancelled
}

model CenterSubscription {
  id            String             @id @default(uuid()) @db.Uuid
  centerId      String             @map("center_id") @db.Uuid
  montant       Decimal            @db.Decimal(10, 2)
  dateDebut     DateTime           @map("date_debut")
  dateFin       DateTime           @map("date_fin")
  statut        SubscriptionStatus @default(active)
  notes         String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([statut])
  @@index([dateFin])
  @@map("center_subscriptions")
}

// ─── PlatformSetting (Configuration globale) ───────────────────────────────

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ─── Monitoring (Santé système, DB, ressources, erreurs) ──────────────────

enum MonitorCheckType {
  server
  database
  resources
}

enum MonitorStatus {
  ok
  warning
  error
}

model MonitorCheck {
  id             String            @id @default(uuid()) @db.Uuid
  type           MonitorCheckType
  status         MonitorStatus
  responseTimeMs Int?              @map("response_time_ms")
  details        Json?
  checkedAt      DateTime          @default(now()) @map("checked_at")

  @@index([type, checkedAt])
  @@index([status, checkedAt])
  @@map("monitor_checks")
}



