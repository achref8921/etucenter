generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  super_admin
  admin
  prof
  eleve
}

enum PresenceStatut {
  present
  absent
}

enum SeanceStatut {
  planifiee
  en_cours
  terminee
  annulee
}

enum InscriptionStatut {
  actif
  inactif
}

// ─── Archivage de groupe (Ajout 2026-09) ────────────────────────────────────
// Un groupe n'est jamais supprimé s'il porte un historique : il passe en
// 'archive'. 'actif' reste la valeur par défaut, donc tout code existant qui
// filtre les groupes continue de fonctionner sans modification.

enum GroupeStatut {
  actif
  archive
}

// ─── Provenance des bornes de période d'inscription (Ajout 2026-09) ──────────
// Une inscription est désormais une PÉRIODE [dateDebut, dateFin] et non plus un
// simple drapeau. Ces deux champs documentent d'où vient chaque borne, ce qui
// permet de distinguer une date réellement connue d'une date jamais enregistrée.

enum InscriptionDateDebutSource {
  inscription // dateDebut = dateInscription (date de saisie d'origine)
  presence // dateDebut = 1re date de séance avec présence (PREUVE materialize)
  saisie // dateDebut saisie manuellement
}

enum InscriptionDateFinSource {
  saisie // date de sortie réellement connue et saisie
  deduit // déduite d'un événement métier explicite et justifiable
  inconnu // legacy : la sortie n'a jamais été enregistrée, elle n'est PAS déductible
}

enum MethodePaiement {
  especes
  virement
  cheque
  autre
}

enum TeacherTransactionType {
  EARNING
  PAYMENT
  ADJUSTMENT
  REVERSAL
  REVERSE_COLLECTION
  CENTER_SETTLEMENT
}

enum TeacherTransactionStatus {
  active
  reversed
  pending
}

enum StudentTransactionType {
  PREPAYMENT
  COURSE_CONSUMPTION
  ADJUSTMENT
  REVERSAL
}

enum StudentTransactionStatus {
  active
  reversed
}

enum NiveauScolaire {
  primaire
  college
  lycee
}

enum Filiere {
  lettres
  economique
  informatique
  technique
  sciences
  math
}

// ─── Center (Tenant) ─────────────────────────────────────────────────────────

model Center {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(20)
  logo      String?  @db.Text
  phone     String?  @db.VarChar(20)
  address   String?  @db.Text
  active    Boolean  @default(true)
  teacherReverseEnabled Boolean @default(false) @map("teacher_reverse_enabled")
  teacherReversePct     Decimal @default(20.00) @map("teacher_reverse_pct") @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  utilisateurs        Utilisateur[]
  groupes             Groupe[]
  matieres            Matiere[]
  notifications       Notification[]
  subscriptions       CenterSubscription[]
  teacherTransactions TeacherTransaction[]
  studentTransactions StudentTransaction[]
  pushSubscriptions   PushSubscription[]
  analyticsEvents     AnalyticsEvent[]
  userSessions        UserSession[]
  seanceDocuments     SeanceDocument[]
  teacherCenterDebts  TeacherCenterDebt[]  @relation("TeacherCenterDebtCenter")
  paiementsAnnules    PaiementAnnule[]
  conversations       Conversation[]

  @@map("centers")
}

// ─── Utilisateur ─────────────────────────────────────────────────────────────

enum Mode {
  FORWARD
  REVERSE
}

enum DebtStatus {
  OPEN
  PARTIAL
  PAID
}

model Utilisateur {
  id              String          @id @default(uuid()) @db.Uuid
  centerId        String          @map("center_id") @db.Uuid
  nom             String          @db.VarChar(255)
  prenom          String          @db.VarChar(255)
  email           String          @unique @db.VarChar(255)
  motDePasse      String?         @map("mot_de_passe") @db.VarChar(255)
  telephone       String?         @db.VarChar(20)
  role            Role
  image           String?
  dateNaissance   DateTime?       @map("date_naissance") @db.Date
  actif           Boolean         @default(false)
  peutGererEleves Boolean         @default(false) @map("peut_gerer_eleves")
  peutEncaisserReverse Boolean    @default(false) @map("peut_encaisser_reverse")
  codeEleve       String?         @map("code_eleve") @db.VarChar(4)
  codeProf        String?         @map("code_prof") @db.VarChar(5)
  niveau          NiveauScolaire?
  classe          String?         @db.VarChar(50)
  filiere         Filiere?
  deletedAt       DateTime?       @map("deleted_at")
  ghost           Boolean         @default(false) @map("ghost")
  lastSeenAt      DateTime?       @map("last_seen_at")

  provider                String?   @default("credentials") @db.VarChar(50)
  providerId              String?   @map("provider_id") @db.VarChar(255)
  emailVerified           DateTime? @map("email_verified")
  emailVerificationToken  String?   @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpiry DateTime? @map("email_verification_expiry")
  passwordResetToken      String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpiry     DateTime? @map("password_reset_expiry")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  center                    Center               @relation(fields: [centerId], references: [id], onDelete: Cascade)
  groupesEnseigne           Groupe[]             @relation("ProfGroupes")
  inscriptions              Inscription[]
  presencesAsEleve          Presence[]           @relation("PresenceEleve")
  presencesByAdmin          Presence[]           @relation("PresenceEnregistrePar")
  paiements                 Paiement[]
  tauxBenefice              TauxBenefice?
  notifications             Notification[]
  teacherTransactions       TeacherTransaction[] @relation("TeacherTransactions")
  studentTransactions       StudentTransaction[] @relation("StudentTransactions")
  pushSubscriptions         PushSubscription[]
  analyticsEvents           AnalyticsEvent[]
  userSessions              UserSession[]
  documentsUploaded         SeanceDocument[]     @relation("SeanceDocuments")
  groupesArchives           Groupe[]             @relation("GroupeArchivedBy")
  reverseCollections        TeacherTransaction[] @relation("TeacherTransactionStudent")
  teacherCenterDebts        TeacherCenterDebt[]  @relation("TeacherCenterDebtTeacher")
  teacherCenterDebtStudents TeacherCenterDebt[]  @relation("TeacherCenterDebtStudent")
  conversationParticipations ConversationParticipant[] @relation("ConversationParticipant")
  messagesEnvoyes            Message[]               @relation("MessageSender")

  @@unique([centerId, codeEleve])
  @@unique([centerId, codeProf])
  @@index([centerId, role])
  @@index([lastSeenAt])
  @@index([centerId, email])
  @@index([centerId, role, createdAt])
  @@index([role])
  @@index([codeEleve])
  @@index([codeProf])
  @@map("utilisateurs")
}

// ─── Matiere ─────────────────────────────────────────────────────────────────

model Matiere {
  id          String   @id @default(uuid()) @db.Uuid
  centerId    String   @map("center_id") @db.Uuid
  nom         String   @db.VarChar(255)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  center  Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  groupes Groupe[]

  @@unique([centerId, nom])
  @@index([centerId])
  @@map("matieres")
}

// ─── Groupe ──────────────────────────────────────────────────────────────────

model Groupe {
  id             String   @id @default(uuid()) @db.Uuid
  centerId       String   @map("center_id") @db.Uuid
  nom            String   @db.VarChar(255)
  description    String?
  profId         String?  @map("prof_id") @db.Uuid
  matiereId      String?  @map("matiere_id") @db.Uuid
  prixParSeance  Decimal  @map("prix_par_seance") @db.Decimal(10, 2)
  forfaitMontant Decimal? @map("forfait_montant") @db.Decimal(10, 2)
  forfaitSeances Int?     @map("forfait_seances")
  capaciteMax    Int?     @map("capacite_max")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Archivage : 'actif' par défaut, donc aucun filtre existant n'est cassé.
  statut       GroupeStatut @default(actif)
  archivedAt   DateTime?    @map("archived_at")
  archivedById String?      @map("archived_by_id") @db.Uuid
  archiveMotif String?      @map("archive_motif")

  center       Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  prof         Utilisateur?  @relation("ProfGroupes", fields: [profId], references: [id], onDelete: SetNull)
  matiere      Matiere?      @relation(fields: [matiereId], references: [id], onDelete: SetNull)
  archivedBy   Utilisateur?  @relation("GroupeArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  inscriptions Inscription[]
  seances      Seance[]
  paiements    Paiement[]

  teacherTransactions TeacherTransaction[] @relation("TeacherTransactionGroupe")
  teacherCenterDebts  TeacherCenterDebt[]  @relation("TeacherCenterDebtGroupe")

  @@index([centerId, profId])
  @@index([centerId])
  @@index([matiereId])
  @@index([centerId, statut])
  @@index([statut, archivedAt])
  @@map("groupes")
}

// ─── Inscription ─────────────────────────────────────────────────────────────

model Inscription {
  id              String            @id @default(uuid()) @db.Uuid
  eleveId         String            @map("eleve_id") @db.Uuid
  groupeId        String            @map("groupe_id") @db.Uuid
  dateInscription DateTime          @default(now()) @map("date_inscription")
  statut          InscriptionStatut @default(actif)
  forfaitMontant  Decimal?          @map("forfait_montant") @db.Decimal(10, 2)
  forfaitSeances  Int?              @map("forfait_seances")
  forfaitSetAt    DateTime?         @map("forfait_set_at")

  // ─── Période d'appartenance (Ajout 2026-09) ───────────────────────────────
  // Une inscription devient une PÉRIODE [dateDebut, dateFin] par groupe.
  //   - dateDebut / dateFin sont des DATES (@db.Date), pas des timestamps :
  //     une séance est un jour entier, et dateInscription porte une heure
  //     (mesuré : 187/187 lignes ont une composante horaire). Comparer une
  //     présence à un timestamp rendrait la frontière du jour ambiguë.
  //   - dateDebut est TOUJOURS renseignée. dateFin est NULL = période ouverte.
  //   - dateFinSource = 'inconnu' signifie "sortie jamais enregistrée" : la
  //     période est fermée mais sa borne haute reste INCONNUE. Cela ne doit
  //     jamais être interprété comme "membre jusqu'à aujourd'hui".
  //   - statut est désormais par PÉRIODE : 'actif' = période courante.
  dateDebut       DateTime                   @default(now()) @map("date_debut") @db.Date
  dateDebutSource InscriptionDateDebutSource @default(inscription) @map("date_debut_source")
  dateFin         DateTime?                  @map("date_fin") @db.Date
  dateFinSource   InscriptionDateFinSource?  @map("date_fin_source")

  // Horodatage technique (distinct des dates métier ci-dessus).
  updatedAt DateTime @updatedAt @map("updated_at")

  eleve  Utilisateur @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  groupe Groupe      @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  // ⚠️ Le @@unique([eleveId, groupeId]) a été RETIRÉ : un élève peut être
  // inscrit plusieurs fois dans le même groupe (A -> B -> A), et surtout dans
  // PLUSIEURS groupes simultanément (max observé en prod : 4).
  // La garantie "une seule période ouverte par couple" est portée par un index
  // PARTIEL au niveau SQL (voir migration 5, "inscriptions_eleve_groupe_ouverte_key"),
  // qu'aucune inscription active ne viole : l'index unique existant sur
  // (eleve_id, groupe_id) garantit qu'il ne peut pas y avoir deux lignes 'actif'
  // pour un même couple.
  // ⚠️ Un index PARTIEL n'est pas exprimable en Prisma : `migrate diff` ne le voit
  // pas. S'il était un jour régénéré depuis ce schéma, la garantie disparaît
  // silencieusement. Un test de garde doit interroger pg_indexes.
  // Conséquence : findUnique({ eleveId_groupeId }) n'existe plus (3 sites).
  @@index([groupeId])
  @@index([groupeId, statut])
  @@index([eleveId, statut])
  @@index([eleveId, groupeId, dateDebut, dateFin])
  @@index([eleveId, dateDebut])
  @@map("inscriptions")
}

// ─── Seance ──────────────────────────────────────────────────────────────────

model Seance {
  id            String       @id @default(uuid()) @db.Uuid
  groupeId      String       @map("groupe_id") @db.Uuid
  date          DateTime     @db.Date
  heureDebut    DateTime?    @map("heure_debut") @db.Time
  heureFin      DateTime?    @map("heure_fin") @db.Time
  statut        SeanceStatut @default(planifiee)
  notes         String?
  prixParSeance Decimal?     @map("prix_par_seance") @db.Decimal(10, 2)
  createdAt     DateTime     @default(now()) @map("created_at")

  groupe              Groupe               @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  presences           Presence[]
  documents           SeanceDocument[]
  teacherTransactions TeacherTransaction[]
  teacherCenterDebts  TeacherCenterDebt[]

  @@index([groupeId, date])
  @@index([date])
  @@map("seances")
}

// ─── SeanceDocument (Supports / fichiers pédagogiques d'une séance) ────────
// Fichiers stockés dans Vercel Blob (store Private) ; uniquement les
// métadonnées en base. centerId est dénormalisé (comme TeacherTransaction /
// StudentTransaction) pour garantir l'isolation multi-tenant et l'indexation.

model SeanceDocument {
  id           String    @id @default(uuid()) @db.Uuid
  centerId     String    @map("center_id") @db.Uuid
  seanceId     String    @map("seance_id") @db.Uuid
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  pathname     String    @db.VarChar(450)
  fileName     String    @map("file_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(100)
  sizeBytes    Int       @map("size_bytes")
  description  String?   @db.VarChar(500)
  // Cycle de vie du dépôt : la ligne est créée AVANT l'upload navigateur
  // ("en_attente") puis confirmée par le callback serveur onUploadCompleted
  // après contrôle réel du blob ("pret"). Une ligne "en_attente" jamais
  // confirmée est un dépôt échoué, nettoyé par le cron.
  statut       String    @default("en_attente") @db.VarChar(20)
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  center     Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  seance     Seance       @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  uploadedBy Utilisateur? @relation("SeanceDocuments", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([seanceId, createdAt])
  @@index([centerId, seanceId])
  @@index([centerId, createdAt])
  @@index([uploadedById])
  @@index([centerId, statut, createdAt])
  @@map("seance_documents")
}

// ─── Presence ────────────────────────────────────────────────────────────────

model Presence {
  id               String         @id @default(uuid()) @db.Uuid
  seanceId         String         @map("seance_id") @db.Uuid
  eleveId          String         @map("eleve_id") @db.Uuid
  statut           PresenceStatut
  enregistrePar    String?        @map("enregistre_par") @db.Uuid
  dateCreation     DateTime       @default(now()) @map("date_creation")
  dateModification DateTime       @default(now()) @map("date_modification")

  seance              Seance               @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  eleve               Utilisateur          @relation("PresenceEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  enregistreur        Utilisateur?         @relation("PresenceEnregistrePar", fields: [enregistrePar], references: [id], onDelete: SetNull)
  studentTransactions StudentTransaction[] @relation("StudentTransactionAttendance")

  @@unique([seanceId, eleveId])
  @@index([eleveId])
  @@index([eleveId, statut])
  @@map("presences")
}

// ─── Paiement ────────────────────────────────────────────────────────────────

model Paiement {
  id              String          @id @default(uuid()) @db.Uuid
  eleveId         String          @map("eleve_id") @db.Uuid
  groupeId        String          @map("groupe_id") @db.Uuid
  montant         Decimal         @db.Decimal(10, 2)
  datePaiement    DateTime        @default(now()) @map("date_paiement")
  methodePaiement MethodePaiement @map("methode_paiement")
  reference       String?
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  tauxApplique    Decimal?        @map("taux_applique") @db.Decimal(5, 2)
  partCentre      Decimal?        @map("part_centre") @db.Decimal(10, 2)
  collecteParProf Boolean         @default(false) @map("collecte_par_prof")
  reverseDebtId   String?         @map("reverse_debt_id") @db.Uuid

  eleve  Utilisateur @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  groupe Groupe      @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@index([eleveId, groupeId])
  @@index([eleveId])
  @@index([groupeId, datePaiement])
  @@index([datePaiement])
  @@index([collecteParProf])
  @@map("paiements")
}

// ─── PaiementAnnule (Registre des paiements annulés) ─────────────────────────
// L'annulation d'un paiement efface définitivement la ligne du paiement ainsi
// que TOUTES les écritures comptables qui en découlent (crédit élève, part du
// professeur, dette centre), de sorte que tous les agrégats financiers existants
// restent exacts sans aucun filtre supplémentaire. Ce registre conserve
// l'empreinte de l'annulation : l'élève, le montant, le motif et l'auteur.

model PaiementAnnule {
  id              String          @id @default(uuid()) @db.Uuid
  centerId        String          @map("center_id") @db.Uuid
  paiementId      String          @map("paiement_id") @db.Uuid
  eleveId         String          @map("eleve_id") @db.Uuid
  eleveNom        String          @map("eleve_nom") @db.VarChar(255)
  groupeId        String          @map("groupe_id") @db.Uuid
  groupeNom       String          @map("groupe_nom") @db.VarChar(255)
  montant         Decimal         @db.Decimal(10, 2)
  methodePaiement MethodePaiement @map("methode_paiement")
  datePaiement    DateTime        @map("date_paiement")
  collecteParProf Boolean         @default(false) @map("collecte_par_prof")
  collecteurId    String?         @map("collecteur_id") @db.Uuid
  collecteurNom   String?         @map("collecteur_nom") @db.VarChar(255)
  motif           String          @db.Text
  annuleParId     String?         @map("annule_par_id") @db.Uuid
  annuleParNom    String?         @map("annule_par_nom") @db.VarChar(255)
  annuleParRole   String?         @map("annule_par_role") @db.VarChar(20)
  annuleLe        DateTime        @default(now()) @map("annule_le")

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId, annuleLe])
  @@index([eleveId])
  @@index([groupeId])
  @@map("paiements_annules")
}

// ─── TauxBenefice ────────────────────────────────────────────────────────────

model TauxBenefice {
  id              String   @id @default(uuid()) @db.Uuid
  profId          String   @unique @map("prof_id") @db.Uuid
  tauxPourcentage Decimal  @map("taux_pourcentage") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  prof Utilisateur @relation(fields: [profId], references: [id], onDelete: Cascade)

  @@map("taux_benefices")
}

// ─── TeacherTransaction (Comptabilité des professeurs) ──────────────────────

model TeacherTransaction {
  id            String                   @id @default(uuid()) @db.Uuid
  centerId      String                   @map("center_id") @db.Uuid
  teacherId     String                   @map("teacher_id") @db.Uuid
  type          TeacherTransactionType
  status        TeacherTransactionStatus @default(active)
  amount        Decimal                  @db.Decimal(10, 2)
  signedAmount  Decimal                  @map("signed_amount") @db.Decimal(10, 2)
  description   String                   @db.Text
  paymentMethod MethodePaiement?         @map("payment_method")
  date          DateTime                 @db.Date
  time          DateTime?                @db.Time
  receiptNumber String?                  @map("receipt_number") @db.VarChar(50)
  reference     String?                  @db.VarChar(100)
  notes         String?                  @db.Text
  createdBy     String?                  @map("created_by") @db.Uuid
  reversalOfId  String?                  @map("reversal_of_id") @db.Uuid
  reversedById  String?                  @map("reversed_by_id") @db.Uuid
  reversedAt    DateTime?                @map("reversed_at")
  createdAt     DateTime                 @default(now()) @map("created_at")

  mode           Mode     @default(FORWARD)
  amountReceived Decimal? @map("amount_received") @db.Decimal(10, 2)
  centerFee      Decimal? @map("center_fee") @db.Decimal(10, 2)
  netAmount      Decimal? @map("net_amount") @db.Decimal(10, 2)
  collectionPct  Decimal? @map("collection_pct") @db.Decimal(5, 2)
  studentId      String?  @map("student_id") @db.Uuid
  seanceId       String?  @map("seance_id") @db.Uuid
  groupeId       String?  @map("groupe_id") @db.Uuid
  direction      String?  @db.VarChar(20)
  linkedDebtId   String?  @map("linked_debt_id") @db.Uuid

  center     Center               @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacher    Utilisateur          @relation("TeacherTransactions", fields: [teacherId], references: [id], onDelete: Cascade)
  student    Utilisateur?         @relation("TeacherTransactionStudent", fields: [studentId], references: [id], onDelete: SetNull)
  seance     Seance?              @relation(fields: [seanceId], references: [id], onDelete: SetNull)
  groupe     Groupe?              @relation("TeacherTransactionGroupe", fields: [groupeId], references: [id], onDelete: SetNull)
  reversalOf TeacherTransaction?  @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals  TeacherTransaction[] @relation("TransactionReversal")
  debt       TeacherCenterDebt?   @relation("ReverseDebtTransactions", fields: [linkedDebtId], references: [id], onDelete: SetNull)

  @@index([centerId, teacherId, date])
  @@index([teacherId, date])
  @@index([type, status])
  @@index([centerId, type])
  @@index([mode, status])
  @@index([seanceId])
  @@index([groupeId])
  @@map("teacher_transactions")
}

model TeacherCenterDebt {
  id             String     @id @default(uuid()) @db.Uuid
  centerId       String     @map("center_id") @db.Uuid
  teacherId      String     @map("teacher_id") @db.Uuid
  studentId      String?    @map("student_id") @db.Uuid
  seanceId       String?    @map("seance_id") @db.Uuid
  groupeId       String?    @map("groupe_id") @db.Uuid
  amountDue      Decimal    @map("amount_due") @db.Decimal(10, 2)
  amountPaid     Decimal    @default(0) @map("amount_paid") @db.Decimal(10, 2)
  balance        Decimal    @db.Decimal(10, 2)
  status         DebtStatus @default(OPEN)
  reverseTxId    String?    @map("reverse_tx_id") @db.Uuid
  settlementTxId String?    @map("settlement_tx_id") @db.Uuid
  notes          String?    @db.Text
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  settledAt      DateTime?  @map("settled_at")

  center             Center               @relation("TeacherCenterDebtCenter", fields: [centerId], references: [id], onDelete: Cascade)
  teacher            Utilisateur          @relation("TeacherCenterDebtTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student            Utilisateur?         @relation("TeacherCenterDebtStudent", fields: [studentId], references: [id], onDelete: SetNull)
  seance             Seance?              @relation(fields: [seanceId], references: [id], onDelete: SetNull)
  groupe             Groupe?              @relation("TeacherCenterDebtGroupe", fields: [groupeId], references: [id], onDelete: SetNull)
  linkedTransactions TeacherTransaction[] @relation("ReverseDebtTransactions")

  @@index([centerId, status])
  @@index([teacherId, status])
  @@index([teacherId, status, settledAt])
  @@index([groupeId])
  @@map("teacher_center_debts")
}

// ─── StudentTransaction (Crédit / Solde prépayé des élèves) ──────────────────

model StudentTransaction {
  id             String                   @id @default(uuid()) @db.Uuid
  centerId       String                   @map("center_id") @db.Uuid
  eleveId        String                   @map("eleve_id") @db.Uuid
  type           StudentTransactionType
  status         StudentTransactionStatus @default(active)
  amount         Decimal                  @db.Decimal(10, 2)
  signedAmount   Decimal                  @map("signed_amount") @db.Decimal(10, 2)
  description    String                   @db.Text
  paymentMethod  MethodePaiement?         @map("payment_method")
  date           DateTime                 @db.Date
  time           DateTime?                @db.Time
  receiptNumber  String?                  @map("receipt_number") @db.VarChar(50)
  reference      String?                  @db.VarChar(100)
  attendanceId   String?                  @map("attendance_id") @db.Uuid
  idempotencyKey String?                  @map("idempotency_key") @db.VarChar(64)
  notes          String?                  @db.Text
  createdBy      String?                  @map("created_by") @db.Uuid
  reversalOfId   String?                  @map("reversal_of_id") @db.Uuid
  reversedById   String?                  @map("reversed_by_id") @db.Uuid
  reversedAt     DateTime?                @map("reversed_at")
  createdAt      DateTime                 @default(now()) @map("created_at")

  center     Center               @relation(fields: [centerId], references: [id], onDelete: Cascade)
  eleve      Utilisateur          @relation("StudentTransactions", fields: [eleveId], references: [id], onDelete: Cascade)
  attendance Presence?            @relation("StudentTransactionAttendance", fields: [attendanceId], references: [id], onDelete: SetNull)
  reversalOf StudentTransaction?  @relation("StudentTransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals  StudentTransaction[] @relation("StudentTransactionReversal")

  @@unique([eleveId, attendanceId])
  @@unique([idempotencyKey])
  @@unique([reversalOfId])
  @@index([centerId, eleveId, date])
  @@index([eleveId, date])
  @@index([type, status])
  @@index([centerId, type])
  @@map("student_transactions")
}

// ─── Notification ────────────────────────────────────────────────────────────

model Notification {
  id             String   @id @default(uuid()) @db.Uuid
  centerId       String   @map("center_id") @db.Uuid
  destinataireId String   @map("destinataire_id") @db.Uuid
  titre          String   @db.VarChar(255)
  message        String   @db.Text
  type           String   @db.VarChar(50)
  lu             Boolean  @default(false)
  lien           String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")

  center       Center      @relation(fields: [centerId], references: [id], onDelete: Cascade)
  destinataire Utilisateur @relation(fields: [destinataireId], references: [id], onDelete: Cascade)

  @@index([centerId, destinataireId])
  @@index([destinataireId, lu])
  @@map("notifications")
}

// ─── PushSubscription (Web Push) ────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  centerId  String   @map("center_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @db.Text
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  center Center      @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user   Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

// ─── SystemLog (Audit) ────────────────────────────────────────────────────

model SystemLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String   @db.VarChar(100)
  entity    String?  @db.VarChar(50)
  entityId  String?  @map("entity_id") @db.Uuid
  details   Json?
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@index([createdAt])
  @@index([userId])
  @@map("system_logs")
}

// ─── SystemBackup (Base de données) ──────────────────────────────────────────

enum BackupStatus {
  en_cours
  ok
  echec
  restaure
}

enum BackupType {
  automatique
  manuel
}

model SystemBackup {
  id          String       @id @default(uuid()) @db.Uuid
  version     Int
  type        BackupType   @default(manuel)
  status      BackupStatus @default(en_cours)
  checksum    String?      @db.VarChar(64)
  sizeBytes   Int?
  rowCounts   Json?
  data        String?      @db.Text
  error       String?      @db.Text
  createdBy   String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?    @map("completed_at")
  restoredAt  DateTime?    @map("restored_at")

  @@index([createdAt])
  @@index([status])
  @@map("system_backups")
}

// ─── CenterSubscription ──────────────────────────────────────────────────────

enum SubscriptionStatus {
  active
  expired
  cancelled
}

model CenterSubscription {
  id        String             @id @default(uuid()) @db.Uuid
  centerId  String             @map("center_id") @db.Uuid
  montant   Decimal            @db.Decimal(10, 2)
  dateDebut DateTime           @map("date_debut")
  dateFin   DateTime           @map("date_fin")
  statut    SubscriptionStatus @default(active)
