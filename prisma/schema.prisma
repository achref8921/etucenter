// ─── Product Analytics (analyse d'usage, distincte de SystemLog) ───────────

enum AnalyticsEventName {
  SESSION_STARTED
  SESSION_ENDED
  PAGE_VIEW
  STUDENT_VIEWED
  STUDENT_CREATED
  STUDENT_UPDATED
  GROUP_VIEWED
  GROUP_CREATED
  GROUP_UPDATED
  ATTENDANCE_VIEWED
  ATTENDANCE_MARKED
  PAYMENT_VIEWED
  PAYMENT_CREATED
  PAYMENT_UPDATED
  PAYMENT_DELETED
  REPORT_EXPORTED
  NOTIFICATION_VIEWED
  ASSISTANT_USED
}

model AnalyticsEvent {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  centerId  String             @map("center_id") @db.Uuid
  sessionId String?            @map("session_id") @db.Uuid
  event     AnalyticsEventName
  path      String?            @db.VarChar(255)
  feature   String?            @db.VarChar(80)
  metadata  Json?
  userAgent String?            @map("user_agent") @db.VarChar(255)
  createdAt DateTime           @default(now()) @map("created_at")

  user    Utilisateur  @relation(fields: [userId], references: [id], onDelete: Cascade)
  center  Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([centerId])
  @@index([event])
  @@index([createdAt])
  @@index([sessionId])
  @@index([centerId, createdAt])
  @@index([event, createdAt])
  @@map("analytics_events")
}

model UserSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  centerId        String    @map("center_id") @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at")
  lastActivityAt  DateTime  @default(now()) @map("last_activity_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")
  endReason       String?   @map("end_reason") @db.VarChar(40)

  user   Utilisateur      @relation(fields: [userId], references: [id], onDelete: Cascade)
  center Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  events AnalyticsEvent[]

  @@index([userId])
  @@index([centerId])
  @@index([startedAt])
  @@index([endedAt])
  @@index([centerId, startedAt])
  @@map("user_sessions")
}

// ─── Messagerie interne (1 à 1) ─────────────────────────────────────────────
// Une conversation relie exactement deux utilisateurs du même centre.
// `pairKey` = identifiants triés ("a:b") : il garantit une seule conversation
// par paire, quel que soit l'ordre d'ouverture.
//
// L'état de lecture est porté par chaque participant :
//   - unreadCount : nombre de messages non lus (dénormalisé pour le badge) ;
//   - lastReadAt  : dernière ouverture du fil (sert aux accusés de lecture).
// Les messages ne sont jamais supprimés en cascade avec un utilisateur sans
// disparaître de la conversation : le pair restant conserve son historique.

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  centerId      String   @map("center_id") @db.Uuid
  pairKey       String   @unique @map("pair_key") @db.VarChar(80)
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  center       Center                    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([centerId, lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  unreadCount    Int       @default(0) @map("unread_count")
  lastReadAt     DateTime? @map("last_read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         Utilisateur  @relation("ConversationParticipant", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, unreadCount])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  content        String    @db.Text
  clientId       String?   @map("client_id") @db.VarChar(64)
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Utilisateur  @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientId])
  @@index([conversationId, createdAt])
  @@index([conversationId, senderId, readAt])
  @@index([senderId])
  @@map("messages")
}
