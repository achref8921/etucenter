  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([statut])
  @@index([dateFin])
  @@map("center_subscriptions")
}

// ─── PlatformSetting (Configuration globale) ───────────────────────────────

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ─── Monitoring (Santé système, DB, ressources, erreurs) ──────────────────

enum MonitorCheckType {
  server
  database
  resources
}

enum MonitorStatus {
  ok
  warning
  error
}

model MonitorCheck {
